# PostgreSQL / TimescaleDB connection
DATABASE_URL=postgresql+asyncpg://skewer:skewer@db:5432/skewer

# Base intraday poll cadence, in minutes. Every other cadence bucket is a
# multiple of this (see app/domain/cadence.py) — changing it changes the grid.
BASE_POLL_MINUTES=5

# Cron for the end-of-day full-chain snapshot (minute hour day month dow, UTC).
# 21:10 UTC = 17:10 ET, ~40min after the US close, giving Yahoo time to settle
# open interest and closing marks.
EOD_SNAPSHOT_CRON=10 21 * * 1-5

# Annualised risk-free rate used by the Black-Scholes greeks (ACT/365).
RISK_FREE_RATE=0.04

LOG_LEVEL=INFO

# --- Euronext (EWS derivatives web service) ---------------------------------
# Requires a licensed auth key issued by Euronext London; there is no anonymous
# or sandbox mode. Leave blank and the Euronext provider refuses to poll rather
# than emitting 401s, and rejects Euronext underlyings at add time.
EURONEXT_AUTH_KEY=
# "RT" real-time or "DT" delayed, depending on what the licence covers.
EURONEXT_SESSION_QUALITY=DT
# This API serves one contract per request and has no chain endpoint, so a
# chain is an enumerated grid. These bounds are what stand between a poll and
# several thousand requests; the cap is a hard stop.
EURONEXT_CONCURRENCY=4
EURONEXT_MAX_REQUESTS=600
EURONEXT_STRIKE_WINDOW_PCT=0.30
EURONEXT_MAX_MATURITIES=6
