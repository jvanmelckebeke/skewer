# PostgreSQL / TimescaleDB connection
DATABASE_URL=postgresql+asyncpg://skewer:skewer@db:5432/skewer

# Base intraday poll cadence, in minutes. Every other cadence bucket is a
# multiple of this (see app/domain/cadence.py) — changing it changes the grid.
BASE_POLL_MINUTES=5

# Cron for the end-of-day full-chain snapshot (minute hour day month dow, UTC).
# 21:10 UTC = 17:10 ET, ~40min after the US close, giving Yahoo time to settle
# open interest and closing marks.
EOD_SNAPSHOT_CRON=10 21 * * 1-5

# Annualised risk-free rate used by the Black-Scholes greeks (ACT/365).
RISK_FREE_RATE=0.04

LOG_LEVEL=INFO
